<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<!--
      The ListMaker producer API targets ASP.NET Core on .NET 10.
    -->
		<TargetFramework>net10.0</TargetFramework>

		<!--
      Enables compile-time nullable-reference-type analysis.
    -->
		<Nullable>enable</Nullable>

		<!--
      Enables the standard implicit namespaces supplied by the Web SDK.
    -->
		<ImplicitUsings>enable</ImplicitUsings>

		<!--
      Generates an XML documentation file. Swashbuckle can use this file to
      enrich the generated OpenAPI document.
    -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!--
      Suppresses warnings for public members that do not require XML comments.
      Important API classes and endpoints will still be documented explicitly.
    -->
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!--
      Adds JWT bearer-token authentication and token validation.
    -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
		<!--<PackageReference Include="Microsoft.OpenApi" />-->

		<!--
      Generates OpenAPI metadata and provides the Swagger UI middleware.
    -->
		<PackageReference Include="Swashbuckle.AspNetCore" />

		<!--
      Supports SwaggerOperation and SwaggerResponse attributes.
    -->
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ListMaker.Contracts\ListMaker.Contracts.csproj" />
	</ItemGroup>

</Project>